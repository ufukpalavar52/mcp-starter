# Where the services write their log files. Alloy mounts this read-only and labels each
# stream by file name: mcp-gateway.log becomes service_name="mcp-gateway".
#
# An absolute path, or one relative to this directory.
MCP_LOG_DIR=./logs

# Which files in it to read. Narrow this when the directory holds more than this stack's
# logs — /tmp with the default pattern collects every unrelated .log left lying there.
MCP_LOG_GLOB=*.log

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
