# Keys, one variable per key. Written here rather than in /tmp, where the first copy of
# this key lived until macOS cleaned the directory and took every sealed value with it.
# .gitignore covers this file.
MCP_CIPHER_KEY_V1=
MCP_CIPHER_ACTIVE_KEY=

MCP_CIPHER_TOKEN=
MCP_CIPHER_ADDRESS=127.0.0.1:9090

# Credentials for mcp-config, which refuses an anonymous caller: it hands out this
# stack's database password, JWT key and broker password. The pair is defined in
# mcp-config/.env; this is a copy so the service can start on its own.
CONFIG_USER=mcp
CONFIG_PASSWORD=
