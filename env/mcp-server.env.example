PUBLISHER_TOKEN=same-string-in-mcp-gateway
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# The router model, the cipher and the broker now come from mcp-config; see
# config-repo/mcp-server.yml there. Setting ROUTER_PROVIDER, ROUTER_ENDPOINT, ROUTER_MODEL
# or OPEN_MODEL_API_KEY here still wins — this machine overrides the central value — which
# is what makes a local experiment possible without editing the config server.
CONFIG_SERVER_URL=http://127.0.0.1:8888

# mcp-config refuses an anonymous caller: it hands out the broker password, the cipher
# token and the router's API key. The pair is defined in mcp-config/.env.
CONFIG_USER=mcp
CONFIG_PASSWORD=change-me
