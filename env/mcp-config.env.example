# Values the config server hands to its clients.
#
# Not committed: .gitignore keeps it out. This is the one place a credential is written
# down, and it is written down here rather than in config-repo/ because config-repo is
# tracked.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mcp
DB_USER=mcp
DB_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

JWT_SECRET_KEY=openssl-rand-base64-32


# Where the panel is served from, for the gateway's CORS. More than one because
# `next dev` takes the first free port and a checkout run without -p lands on 3000.
CORS_ORIGINS=http://localhost:3000

# The model that routes a prompt to a tool, and the key for its endpoint.
#
# Plain text here rather than sealed in the database, and not by preference: routing runs
# before any tool is chosen, so there is no definition whose sealed key it could use. This
# file is already the one place a credential is written down.
ROUTER_API_KEY=your-model-provider-key

# Shared secret between mcp-gateway and mcp-cipher.
MCP_CIPHER_TOKEN=same-string-in-mcp-cipher

# RabbitMQ, between the planner and mcp-action.
QUEUE_HOST=127.0.0.1
QUEUE_PORT=5672
QUEUE_USER=guest
QUEUE_PASSWORD=change-me


# Credentials for this server itself. Every client presents them; without them the
# database password, the JWT key and the broker password below went to anyone who could
# reach the port.
CONFIG_USER=mcp
CONFIG_PASSWORD=change-me
