# Where mcp-config lives. The panel reads its own configuration from there, server side,
# and serves the browser's share of it from /api/config.
CONFIG_SERVER_URL=http://127.0.0.1:8888

# Last resort only, used when the config server cannot be reached. Kept so a checkout with
# nothing else running is still usable — the panel says on screen when it falls back to it.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Credentials for mcp-config, which refuses an anonymous caller: it hands out this
# stack's database password, JWT key and broker password. The pair is defined in
# mcp-config/.env; this is a copy so the service can start on its own.
CONFIG_USER=mcp
CONFIG_PASSWORD=change-me
