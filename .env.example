# Where the six repositories are. The defaults assume they sit beside this one;
# point these at wherever you cloned them.
MCP_GATEWAY_PATH=../mcp-gateway
MCP_CONFIG_PATH=../mcp-config
MCP_SERVER_PATH=../mcp-server
MCP_ACTION_PATH=../mcp-action
MCP_CIPHER_PATH=../mcp-cipher
MCP_PANEL_PATH=../mcp-panel

# Where the services write their logs. The observability stack reads the same
# directory — see observability/README.md.
MCP_LOG_DIR=./logs

# --- credentials -----------------------------------------------------------------
# Nothing here has a default. A stack that starts with a blank password is a stack
# nobody notices is open.

# Every service authenticates to mcp-config with this pair.
CONFIG_USER=mcp
CONFIG_PASSWORD=

DB_DATABASE=mcp
DB_USER=mcp
DB_PASSWORD=

REDIS_PASSWORD=

QUEUE_USER=mcp
QUEUE_PASSWORD=

# openssl rand -base64 32
JWT_SECRET_KEY=

# The encryption key. openssl rand -base64 32.
#
# Lose it and every sealed value in the database is unreadable, for good: it lives in
# the mcp-cipher process and reaches neither the config server nor the database. That
# is what makes a copy of the database not a copy of the data.
MCP_CIPHER_KEY_V1=
MCP_CIPHER_ACTIVE_KEY=v1

# Shared between mcp-cipher and everything that calls it.
MCP_CIPHER_TOKEN=

# Shared between mcp-gateway and mcp-server. Leave empty to run the MCP server's
# publish routes unauthenticated, which is only reasonable on a laptop.
PUBLISHER_TOKEN=

# The model that turns a sentence into a tool call. Without it the router cannot plan,
# and the console answers that no model is configured.
ROUTER_API_KEY=

# --- ports and addresses ---------------------------------------------------------
# All bound to 127.0.0.1 in the compose file. Change these if something already has them.
PANEL_PORT=3000
RABBITMQ_UI_PORT=15672
GATEWAY_PORT=8080
MCP_SERVER_PORT=8000

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
